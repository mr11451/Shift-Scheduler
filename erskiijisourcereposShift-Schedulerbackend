[32m+[m[41m[m
[32m+[m[32m4. アクセス[m[41m[m
[32m+[m[41m[m
[32m+[m[32m- http://127.0.0.1:8000[m[41m[m
[32m+[m[32m- ログイン画面が表示されます[m[41m[m
[32m+[m[32m- テストパスワードを使用してログインしてください（例: staffCode=`STF-00001`, password=`test_stf-00001`）[m[41m[m
[32m+[m[41m[m
[32m+[m[32m## フロント開発モード[m[41m[m
[32m+[m[41m[m
[32m+[m[32m```bash[m[41m[m
[32m+[m[32mcd frontend[m[41m[m
[32m+[m[32mnpm install[m[41m[m
[32m+[m[32mnpm run dev[m[41m[m
