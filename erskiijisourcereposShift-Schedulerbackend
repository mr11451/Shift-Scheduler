[32m+[m[41m[m
[32m+[m[32m## API[m[41m[m
[32m+[m[41m[m
[32m+[m[32m### 認証エンドポイント[m[41m[m
[32m+[m[32m- `POST /api/login` - ログイン (staffCode, password を入力)[m[41m[m
[32m+[m[32m  - レスポンス: `{ token, staffId, staffCode, staffName, roleLevel }`[m[41m[m
[32m+[m[41m[m
[32m+[m[32m### 保護されたエンドポイント（認証必須）[m[41m[m
[32m+[m[41m[m
[32m+[m[32m**全員がアクセス可能:**[m[41m[m
[32m+[m[32m- `GET /api/staffs` - スタッフ一覧[m[41m[m
[32m+[m[32m- `GET /api/shift-types` - シフト種類一覧[m[41m[m
[32m+[m[32m- `GET /api/shift-assignments` - シフト割り当て一覧（照会）[m[41m[m
[32m+[m[41m[m
[32m+[m[32m**CHIEF/MASTER のみ:**[m[41m[m
[32m+[m[32m- `POST /api/shift-assignments` - シフト割り当て作成[m[41m[m
[32m+[m[32m- `PUT /api/shift-assignments/{id}` - シフト割り当て更新[m[41m[m
[32m+[m[32m- `DELETE /api/shift-assignments/{id}` - シフト割り当て削除[m[41m[m
[32m+[m[41m[m
[32m+[m[32m**MASTER のみ:**[m[41m[m
[32m+[m[32m- `POST /api/shift-types` - シフト種類作成[m[41m[m
[32m+[m[32m- `PUT /api/shift-types/{id}` - シフト種類更新[m[41m[m
[32m+[m[32m- `DELETE /api/shift-types/{id}` - シフト種類削除[m[41m[m
[32m+[m[41m[m
[32m+[m[32m### テストユーザー[m[41m[m
[32m+[m[41m[m
[32m+[m[32mアプリケーション起動時に、以下のテストパスワードが自動生成されます：[m[41m[m
[32m+[m[32m- スタッフコード: `STF-00001` 形式[m[41m[m
[32m+[m[32m- パスワード: `test_stf-00001` 形式[m[41m[m
[32m+[m[41m[m
[32m+[m[32m例：[m[41m[m
[32m+[m[32m- staffCode: `STF-00001`, password: `test_stf-00001`[m[41m[m
[32m+[m[32m- staffCode: `STF-00002`, password: `test_stf-00002`[m[41m[m
[32m+[m[41m[m
[32m+[m[32m## DBマイグレーション[m[41m[m
[32m+[m[41m[m
[32m+[m[32m- Flyway を使用しています[m[41m[m
[32m+[m[32m- マイグレーションファイル配置先: `backend/src/main/resources/db/migration`[m[41m[m
[32m+[m[32m- 初期スキーマ: `V1__create_shifts_table.sql`[m[41m[m
[32m+[m[32m- 認証関連: `V11__add_password_to_staffs.sql` (password_hash列追加)[m[41m[m
[32m+[m[32m- 既存DB導入時のため `spring.flyway.baseline-on-migrate=true` を設定済みです[m[41m[m
[32m+[m[41m[m
[32m+[m[32mローカルでサーバー起動時（`mvnw spring-boot:run`）または Docker 起動時に、未適用のマイグレーションが自動適用されます。[m[41m[m
[32m+[m[41m[m
[32m+[m[32m## セキュリティ設定[m[41m[m
[32m+[m[41m[m
[32m+[m[32m- **JWT トークン** - 24時間有効期限で発行[m[41m[m
[32m+[m[32m- **パスワードハッシング** - SHA-256 + ランダムソルト[m[41m[m
[32m+[m[32m- **認証フィルター** - すべてのリクエストに JWT 検証[m[41m[m
[32m+[m[32m- **ロール認可** - メソッドレベルで @RequireRole アノテーション適用[m[41m[m
[32m+[m[32m- **本番環境では必須** - JWT秘密鍵の変更（JwtTokenUtil.java 参照）[m[41m[m
