[32m+[m[32mexport DB_PORT=5432[m[41m[m
[32m+[m[32mexport DB_NAME=shift_scheduler[m[41m[m
[32m+[m[32mexport DB_USER=shift_user[m[41m[m
[32m+[m[32mexport DB_PASSWORD=shift_password[m[41m[m
[32m+[m[32m```[m[41m[m
[32m+[m[41m[m
[32m+[m[32m2. React をビルド[m[41m[m
[32m+[m[41m[m
[32m+[m[32m```bash[m[41m[m
[32m+[m[32mcd frontend[m[41m[m
[32m+[m[32mnpm install[m[41m[m
[32m+[m[32mnpm run build[m[41m[m
[32m+[m[32mcd ..[m[41m[m
