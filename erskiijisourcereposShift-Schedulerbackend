[32m+[m[32m## 最短起動（Docker）[m[41m[m
[32m+[m[41m[m
[32m+[m[32m1. 起動[m[41m[m
[32m+[m[41m[m
[32m+[m[32m```bash[m[41m[m
[32m+[m[32mdocker compose up --build[m[41m[m
[32m+[m[32m```[m[41m[m
[32m+[m[41m[m
[32m+[m[32m2. アクセス[m[41m[m
[32m+[m[41m[m
[32m+[m[32m- http://127.0.0.1:8000[m[41m[m
[32m+[m[32m- ログイン画面が表示されます[m[41m[m
[32m+[m[32m- テストパスワードを使用してログインしてください（例: staffCode=`STF-00001`, password=`test_stf-00001`）[m[41m[m
[32m+[m[41m[m
[32m+[m[32m3. 停止[m[41m[m
