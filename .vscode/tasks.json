{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend:run-wsl",
      "type": "shell",
      "command": "wsl",
      "args": [
        "-e",
        "bash",
        "-lc",
        "cd \"$(wslpath '${workspaceFolder}/backend')\" && exec ./mvnw spring-boot:run -Dspring-boot.run.arguments=--spring.profiles.active=dev"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "backend:compile-wsl",
      "type": "shell",
      "command": "wsl",
      "args": [
        "-e",
        "bash",
        "-lc",
        "cd \"$(wslpath '${workspaceFolder}/backend')\" && ./mvnw -DskipTests compile"
      ],
      "isBackground": false
    },
    {
      "label": "backend:test-wsl",
      "type": "shell",
      "command": "wsl",
      "args": [
        "-e",
        "bash",
        "-lc",
        "cd \"$(wslpath '${workspaceFolder}/backend')\" && ./mvnw test"
      ],
      "isBackground": false
    },
    {
      "label": "backend:test-shift-assignment-wsl",
      "type": "shell",
      "command": "wsl",
      "args": [
        "-e",
        "bash",
        "-lc",
        "cd \"$(wslpath '${workspaceFolder}/backend')\" && ./mvnw -Dtest=ShiftAssignmentServiceTests test"
      ],
      "isBackground": false
    },
    {
      "label": "frontend:build-wsl",
      "type": "shell",
      "command": "wsl",
      "args": [
        "-e",
        "bash",
        "-lc",
        "cd \"$(wslpath '${workspaceFolder}/frontend')\" && npm run build"
      ],
      "isBackground": false
    }
  ]
}
