#!/usr/bin/env sh
set -eu

MAVEN_VERSION="3.9.9"
BASE_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
MAVEN_HOME="$BASE_DIR/.mvn/apache-maven-$MAVEN_VERSION"
MAVEN_BIN="$MAVEN_HOME/bin/mvn"
DOWNLOAD_URL="https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz"
ARCHIVE_PATH="$BASE_DIR/.mvn/apache-maven-$MAVEN_VERSION-bin.tar.gz"

if [ ! -x "$MAVEN_BIN" ]; then
  echo "Maven $MAVEN_VERSION not found. Downloading..."
  mkdir -p "$BASE_DIR/.mvn"

  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$DOWNLOAD_URL" -o "$ARCHIVE_PATH"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$DOWNLOAD_URL" -O "$ARCHIVE_PATH"
  else
    echo "curl or wget is required to download Maven."
    exit 1
  fi

  tar -xzf "$ARCHIVE_PATH" -C "$BASE_DIR/.mvn"
  rm -f "$ARCHIVE_PATH"
fi

exec "$MAVEN_BIN" "$@"
